  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "scenario_id": {
            "type": "string",
            "enum": [
              "normal",
              "rain",
              "snow"
            ],
            "title": "Scenario Id"
          },
          "weights": {
            "$ref": "#/components/schemas/Weights"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "order_id",
          "scenario_id"
        ],
        "title": "AnalysisRequest"
      },
      "Channel": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "budget": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Budget"
          },
          "cpm": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Cpm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "budget",
          "cpm"
        ],
        "title": "Channel"
      },
      "Experiment": {
        "properties": {
          "a_visitors": {
            "type": "integer",
            "maximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "A Visitors"
          },
          "a_conversions": {
            "type": "integer",
            "minimum": 0.0,
            "title": "A Conversions"
          },
          "b_visitors": {
            "type": "integer",
            "maximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "B Visitors"
          },
          "b_conversions": {
            "type": "integer",
            "minimum": 0.0,
            "title": "B Conversions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "a_visitors",
          "a_conversions",
          "b_visitors",
          "b_conversions"
        ],
        "title": "Experiment"
      },
      "ExplainRequest": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "default": "请解释推荐依据、适用限制与需要人工核实的事项。"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "report_id"
        ],
        "title": "ExplainRequest"
      },
      "Growth": {
        "properties": {
          "exposure": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Exposure"
          },
          "visit_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Visit Rate"
          },
          "register_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Register Rate"
          },
          "activate_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Activate Rate"
          },
          "retain_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Retain Rate"
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/Channel"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Channels"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "exposure",
          "visit_rate",
          "register_rate",
          "activate_rate",
          "retain_rate",
          "channels"
        ],
        "title": "Growth"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Id"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "cargo": {
            "type": "string",
            "enum": [
              "general",
              "cold",
              "fragile"
            ],
            "title": "Cargo"
          },
          "weight": {
